<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 解锁:生物识别 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Android 13+:通知栏常驻 Tile / 紧急锁 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 保存助记词备份图片。Android 10+ (API 29+) 用 scoped storage (MediaStore)
         不需要权限;Android 9 及以下需要 WRITE_EXTERNAL_STORAGE 运行时权限。
         maxSdkVersion=28 让系统在 Android 10+ 不会要求用户授权。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 严格离线:不申请 INTERNET -->
    <!-- 自动备份:写入应用专属 Documents 目录,不需要外部存储权限 -->

    <application
        android:name=".AccountBookApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AccountBook.Splash"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection|navigation|touchscreen"
            android:theme="@style/Theme.AccountBook.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 长按图标弹出 "锁定 AccountBook" -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Phase 4 #34: Quick Settings Tile -->
        <service
            android:name=".security.lock.LockNowTileService"
            android:label="@string/tile_lock_label"
            android:icon="@drawable/ic_launcher_foreground"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- 长按 tile 启动 app 时用 meta-data 指明,系统会调 TileService.requestListeningState -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>
    </application>

</manifest>