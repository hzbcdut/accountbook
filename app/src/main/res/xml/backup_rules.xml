<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- 备份策略:不要备份加密的 Room DB 或 EncryptedSharedPreferences。
         这些数据需要解锁后才能解密,云备份会破坏端到端加密语义。 -->
    <exclude domain="database" path="accountbook.db" />
    <exclude domain="database" path="accountbook.db-journal" />
    <exclude domain="database" path="accountbook.db-shm" />
    <exclude domain="database" path="accountbook.db-wal" />
    <exclude domain="sharedpref" path="accountbook_secure_prefs.xml" />
</full-backup-content>