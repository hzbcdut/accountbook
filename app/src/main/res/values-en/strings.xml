    <!-- Phase 4 #31: SetupWizard steps -->
    <string name="wizard_welcome_title">Protect your AccountBook</string>
    <string name="wizard_welcome_body">AccountBook never uploads your accounts. To prevent others with physical access from reading them, set a local PIN and a 12-word recovery phrase.</string>
    <string name="wizard_welcome_start">Get started</string>
    <string name="wizard_welcome_skip">Skip for now (enable later in Settings)</string>
    <string name="wizard_pin_title">Set a PIN</string>
    <string name="wizard_pin_body">At least %1$d characters. This PIN unlocks AccountBook; if you forget it, only the recovery phrase can restore access.</string>
    <string name="wizard_confirm_title">Confirm PIN</string>
    <string name="wizard_confirm_body">Enter the same PIN once more.</string>
    <string name="wizard_confirm_mismatch">PINs do not match</string>
    <string name="wizard_biometric_label">Also enable biometric unlock</string>
    <string name="wizard_mnemonic_title">Write down these 12 words</string>
    <string name="wizard_mnemonic_body">Write them on paper in order. **This is the only way to recover your AccountBook** — AccountBook does not store this phrase anywhere.</string>
    <string name="wizard_mnemonic_ack">I have written them down</string>
    <string name="wizard_verify_title">Verify</string>
    <string name="wizard_verify_body">Enter the %1$d-th word</string>
    <string name="wizard_verify_wrong">Wrong word, check your transcription</string>
    <string name="wizard_finishing">Finishing setup…</string>

    <!-- Phase 4 #31: BiometricPrompt text (for BiometricGate) -->
    <string name="biometric_title">Unlock AccountBook</string>
    <string name="biometric_subtitle">Use biometric or device PIN / pattern / password</string>

    <!-- Phase 4 #31: Migration wizard (v0.3.0 upgrade users) -->
    <string name="migration_pin_title">Set a new PIN for AccountBook</string>
    <string name="migration_pin_body">At least %1$d characters. After upgrading from v0.3.0, the local database will be re-encrypted with a key derived from this PIN. Your existing data is preserved.</string>
    <string name="migration_confirm_title">Confirm the new PIN</string>
    <string name="migration_confirm_body">Enter the same PIN once more; it will be used to re-encrypt the local database.</string>
    <string name="migration_progress">Re-encrypting the database, please wait…</string>
    <string name="migration_interrupted_title">Last upgrade was interrupted</string>
    <string name="migration_interrupted_body">The database has been re-encrypted with the new key, but PIN setup did not finish. **For safety, this cannot be retried.** Please restore from a recent backup, or downgrade to v0.3.x and re-import your data before upgrading again.</string>
    <string name="migration_action_restore_backup">Restore from backup</string>
